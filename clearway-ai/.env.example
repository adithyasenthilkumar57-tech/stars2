# ClearWay AI - Environment Variables Template
# Copy this file to .env for local development

NODE_ENV=development
PORT=3000

# App identity
VITE_APP_ID=clearway-ai-local

# JWT secret for local session tokens
JWT_SECRET=clearway-local-dev-secret-2024-xyz

# Optional: OAuth server (not required for local simulation)
OAUTH_SERVER_URL=

# Optional: Database (not required for in-memory simulation)
DATABASE_URL=

# Optional: Owner identity
OWNER_OPEN_ID=

# Optional: Analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional: AI Features
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
